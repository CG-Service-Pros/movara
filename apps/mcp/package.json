{
  "name": "@movara/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./http-handler": "./src/http-handler.ts",
    "./*": "./src/*.ts"
  },
  "bin": {
    "movara-mcp": "./src/stdio.ts"
  },
  "scripts": {
    "dev": "tsx watch src/http.ts",
    "start": "tsx src/http.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "start:http": "tsx src/http.ts",
    "start:stdio": "tsx src/stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@movara/core": "workspace:*",
    "@movara/db": "workspace:*",
    "@movara/terminology": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@movara/config": "workspace:*",
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
