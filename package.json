{
  "name": "movara",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@movara/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @movara/db db:generate",
    "db:migrate": "pnpm --filter @movara/db db:migrate",
    "db:seed": "pnpm --filter @movara/db db:seed",
    "db:reset": "pnpm --filter @movara/db db:reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
