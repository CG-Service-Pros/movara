# syntax=docker/dockerfile:1.7
# Standalone Movara MCP server (streamable HTTP on :3333). Build from the repo root:
#   docker build -f docker/Dockerfile.mcp -t movara-mcp .
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /app

FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2 prune @movara/mcp --docker

FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .

FROM base AS runner
ENV NODE_ENV=production PORT=3333
RUN groupadd --system --gid 1001 movara && useradd --system --uid 1001 --gid movara --create-home movara
COPY --from=builder --chown=movara:movara /app /app
USER movara
EXPOSE 3333
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3333)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
WORKDIR /app/apps/mcp
# src/http.ts runs migrations on boot; it is TypeScript, run through tsx (a devDependency kept in this image).
CMD ["pnpm", "start"]
