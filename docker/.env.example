# Copy to docker/.env and edit:  cp docker/.env.example docker/.env
# Then:  docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build

# Postgres (internal to the compose network; the port is not published)
POSTGRES_USER=motion
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=motion

# Better Auth: generate with `openssl rand -base64 32`. REQUIRED.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Public URL users open in the browser (change both when behind a domain / reverse proxy)
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Host ports
WEB_PORT=3000
MCP_PORT=3333

# 1 = seed the demo org "vindex" (demo@motion.local / motion-demo). Leave 0 for a real install.
MOTION_SEED_DEMO=0

# Terminology packs to preinstall (comma-separated npm names)
MOTION_TERMINOLOGY_PACKS=@motion-community/pack-eos

# Email (optional; without SMTP, emails are logged to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Motion <no-reply@example.com>
