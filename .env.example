# Database. Leave blank to use embedded PGlite at ./.data/pglite (dev, tests, demo).
# Examples: postgres://user:pass@localhost:5432/movara   |  pglite://./.data/pglite
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Email (optional; invitations and recaps). Without SMTP, emails are logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Movara <no-reply@example.com>

# Comma-separated npm names of terminology packs to preinstall.
MOVARA_TERMINOLOGY_PACKS=@movara-community/pack-eos

# Demo data. Default: seed the "vindex" demo org when the database is embedded PGlite and empty.
# Set to 1 to also seed a real Postgres, 0 to never seed.
MOVARA_SEED_DEMO=
